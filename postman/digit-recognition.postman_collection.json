{
  "info": {
    "name": "Handwritten Digit Recognition API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run top-to-bottom (Collection Runner) against a running Flask API. Select an image file in the 'Predict' request first."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "predictionId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        },
        "description": "Is the API up, the model loaded and PostgreSQL reachable?"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('success flag', () => pm.expect(pm.response.json().success).to.eql(true));",
              "pm.test('model + db up', () => { const j = pm.response.json(); pm.expect(j.model_loaded).to.be.true; pm.expect(j.database_connected).to.be.true; });"
            ]
          }
        }
      ]
    },
    {
      "name": "Predict (upload samples/digit_3.png)",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/predict",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "predict"
          ]
        },
        "description": "In Postman: click the 'image' value and pick a file from the samples/ folder.",
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "image",
              "type": "file",
              "src": "samples/digit_3.png"
            },
            {
              "key": "source",
              "value": "upload",
              "type": "text"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('success flag', () => pm.expect(pm.response.json().success).to.eql(true));",
              "const j = pm.response.json();",
              "pm.test('digit 0-9', () => pm.expect(j.predicted_digit).to.be.within(0,9));",
              "pm.test('confidence 0-1', () => pm.expect(j.confidence).to.be.within(0,1));",
              "pm.test('top3 has 3 entries', () => pm.expect(j.top3.length).to.eql(3));",
              "pm.test('saved to DB', () => pm.expect(j.saved).to.be.true);",
              "pm.collectionVariables.set('predictionId', j.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Predict - no file (400)",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/predict",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "predict"
          ]
        },
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 400', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "Predict - wrong type (415)",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/predict",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "predict"
          ]
        },
        "description": "Attach any .txt/.md file.",
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "image",
              "type": "file",
              "src": "README.md"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 415', () => pm.response.to.have.status(415));"
            ]
          }
        }
      ]
    },
    {
      "name": "List predictions",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/predictions?limit=20",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "predictions"
          ],
          "query": [
            {
              "key": "limit",
              "value": "20"
            }
          ]
        },
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('success flag', () => pm.expect(pm.response.json().success).to.eql(true));",
              "pm.test('newest first', () => { const p = pm.response.json().predictions; for (let i=1;i<p.length;i++) pm.expect(p[i-1].id).to.be.above(p[i].id); });"
            ]
          }
        }
      ]
    },
    {
      "name": "List predictions filtered by digit",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/predictions?digit=3&limit=10",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "predictions"
          ],
          "query": [
            {
              "key": "digit",
              "value": "3"
            },
            {
              "key": "limit",
              "value": "10"
            }
          ]
        },
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('success flag', () => pm.expect(pm.response.json().success).to.eql(true));"
            ]
          }
        }
      ]
    },
    {
      "name": "Get prediction by id",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/predictions/{{predictionId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "predictions",
            "{{predictionId}}"
          ]
        },
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('success flag', () => pm.expect(pm.response.json().success).to.eql(true));"
            ]
          }
        }
      ]
    },
    {
      "name": "Get prediction - not found (404)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/predictions/999999",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "predictions",
            "999999"
          ]
        },
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 404', () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    },
    {
      "name": "Submit feedback (correct the digit)",
      "request": {
        "method": "PATCH",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/predictions/{{predictionId}}/feedback",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "predictions",
            "{{predictionId}}",
            "feedback"
          ]
        },
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"corrected_digit\": 3\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('success flag', () => pm.expect(pm.response.json().success).to.eql(true));",
              "pm.test('stored', () => pm.expect(pm.response.json().prediction.corrected_digit).to.eql(3));"
            ]
          }
        }
      ]
    },
    {
      "name": "Feedback - invalid digit (400)",
      "request": {
        "method": "PATCH",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/predictions/{{predictionId}}/feedback",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "predictions",
            "{{predictionId}}",
            "feedback"
          ]
        },
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"corrected_digit\": 42\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 400', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "Statistics",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/predictions/stats",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "predictions",
            "stats"
          ]
        },
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('success flag', () => pm.expect(pm.response.json().success).to.eql(true));",
              "pm.test('has counts', () => pm.expect(Object.keys(pm.response.json().stats.digit_counts).length).to.eql(10));"
            ]
          }
        }
      ]
    },
    {
      "name": "Export CSV",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/predictions/export",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "predictions",
            "export"
          ]
        },
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('is csv', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('text/csv'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Delete prediction",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/predictions/{{predictionId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "predictions",
            "{{predictionId}}"
          ]
        },
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('success flag', () => pm.expect(pm.response.json().success).to.eql(true));"
            ]
          }
        }
      ]
    },
    {
      "name": "Delete again (404)",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/predictions/{{predictionId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "predictions",
            "{{predictionId}}"
          ]
        },
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 404', () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    }
  ]
}